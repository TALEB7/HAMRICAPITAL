# ============================================================
# HAMRI CAPITAL — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais commité.
# ============================================================

# Domaine public définitif du site (sert aux metadata, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=https://hamricapital.com

# --- Envoi des emails (Resend) -------------------------------
RESEND_API_KEY=
# Adresse d'expédition : doit appartenir à un domaine vérifié chez Resend.
MAIL_FROM="HAMRI CAPITAL <no-reply@hamricapital.com>"

# --- Routage par département ---------------------------------
# Demandes de service (13 divisions) + demandes de conseil
MAIL_TO_INFO=info@hamricapital.com
# Candidatures stage / carrières
MAIL_TO_HR=hr@hamricapital.com
# Contact général et réclamations
MAIL_TO_LEGAL=legal@hamricapital.com
# La Communauté / VIP Business Club, partenariats stratégiques, presse
MAIL_TO_CEO=ceo@hamricapital.com

# Pour passer à des adresses dédiées par division (assetmanagement@…,
# privateequity@…), ajouter ici MAIL_TO_<DIVISION> et compléter la table
# de routage dans src/lib/mail.ts — aucune refonte nécessaire.

# --- Anti-spam (reCAPTCHA v3) --------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
